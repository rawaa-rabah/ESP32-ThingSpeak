#include <WiFi.h>
#include "ThingSpeak.h"
#include "DHTesp.h"

// WIFI Name 
const char* WIFI_Name = "Wokwi-GUEST";
const char* WIFI_Pass = "";

const long channelNumber = 3551588;
const char* apiKey = "09GS8SUV8L7U9PY0";

const char* UNIVERSITY_ID = "12325320";

const int DHT_PIN = 15;
DHTesp dht;

WiFiClient clientObject;

void setup() {

  Serial.begin(115200);

  // start the DHT22 sensor on pin 15
  dht.setup(DHT_PIN, DHTesp::DHT22);

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_Name, WIFI_Pass);

  while (WiFi.status() != WL_CONNECTED)
  {
    Serial.println("Status: Not Connected");
    delay(1000);
  }
  Serial.println("Status: Connected");
  ThingSpeak.begin(clientObject);
}

void loop() {

  TempAndHumidity data = dht.getTempAndHumidity();

  if (isnan(data.temperature) || isnan(data.humidity))
  {
    Serial.println("DHT read failed");
    delay(2000);
    return;
  }

  ThingSpeak.setField(1, data.temperature);   // Field 1 = Temperature
  ThingSpeak.setField(2, data.humidity);      // Field 2 = Humidity

  int stat = ThingSpeak.writeFields(channelNumber, apiKey);

  
  Serial.print("[ID: ");
  Serial.print(UNIVERSITY_ID);
  Serial.print("] Temp: ");
  Serial.print(data.temperature, 1);
  Serial.print(" C | Hum: ");
  Serial.print(data.humidity, 1);
  Serial.print(" % | ");

  if (stat == 200)
  {
    Serial.println("Data Sent to ThingSpeak");
  }
  else
  {
    Serial.print("Send failed, code: ");
    Serial.println(stat);
  }

  delay(20000);
}
